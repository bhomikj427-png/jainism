  "paryaya"       [label="paryāya"      style=filled fillcolor="#f5c518" shape=ellipse];
  "tirthankara"   [label="tīrthaṅkara" style=filled fillcolor="#f5c518" shape=ellipse];
  "catuskoti"     [label="catuṣkoṭi"   style=filled fillcolor="#ffa07a" shape=ellipse];
  "namarupa"      [label="nāmarūpa"     style=filled fillcolor="#ffa07a" shape=ellipse];
  "abhidharma"    [label="abhidharma"   style=filled fillcolor="#ffa07a" shape=ellipse];
  "aparigraha"    [label="aparigraha"   style=filled fillcolor="#f5c518" shape=ellipse];
  "sat"           [label="sat"          style=filled fillcolor="#f5c518" shape=ellipse];

  /* New unwritten stub */
  "avatara-vedanta" [label="avatāra (Vedānta)" style=filled fillcolor="#dddddd" shape=box];

