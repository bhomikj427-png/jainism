digraph ancient_texts {
  rankdir=LR;
  fontname=Helvetica;
  node [fontname=Helvetica fontsize=10];
  edge [fontname=Helvetica fontsize=8];

  /* === COLOUR KEY ===
     Jain:                #f5c518
     Nyaya-Vaisheshika:   #82b4ff
     Samkhya:             #d8b4fe
     Vedanta:             #b0e0b0
     Buddhist:            #ffa07a
     Greek:               #c0c0c0
     Modern Physics:      #e0e0e0
     Unwritten stub:      #dddddd
  */

  /* === WRITTEN NODES === */

  /* Jain */
  "tattva-jain"         [label="tattva (Jain)"         style=filled fillcolor="#f5c518" shape=ellipse];
  "pramana"             [label="pramāṇa"               style=filled fillcolor="#f5c518" shape=ellipse];
  "naya"                [label="naya"                  style=filled fillcolor="#f5c518" shape=ellipse];
  "jiva"                [label="jīva"                  style=filled fillcolor="#f5c518" shape=ellipse];
  "ajiva"               [label="ajīva"                 style=filled fillcolor="#f5c518" shape=ellipse];
  "dravya"              [label="dravya"                style=filled fillcolor="#f5c518" shape=ellipse];
  "paramanu"            [label="paramāṇu"              style=filled fillcolor="#f5c518" shape=ellipse];
  "pudgala"             [label="pudgala"               style=filled fillcolor="#f5c518" shape=ellipse];
  "skandha"             [label="skandha (Jain)"        style=filled fillcolor="#f5c518" shape=ellipse];
  "asrava"              [label="āsrava"                style=filled fillcolor="#f5c518" shape=ellipse];
  "karma"               [label="karma (Jain)"          style=filled fillcolor="#f5c518" shape=ellipse];
  "bandha"              [label="bandha"                style=filled fillcolor="#f5c518" shape=ellipse];
  "nirjara"             [label="nirjarā"               style=filled fillcolor="#f5c518" shape=ellipse];
  "samvara"             [label="saṃvara"               style=filled fillcolor="#f5c518" shape=ellipse];
  "moksha"              [label="mokṣa (Jain)"          style=filled fillcolor="#f5c518" shape=ellipse];
  "anekantavada"        [label="anekāntavāda"          style=filled fillcolor="#f5c518" shape=ellipse];
  "syadvada"            [label="syādvāda"              style=filled fillcolor="#f5c518" shape=ellipse];
  "saptabhangi"         [label="saptabhaṅgī"           style=filled fillcolor="#f5c518" shape=ellipse];
  "kevala-jnana"        [label="kevala-jñāna"          style=filled fillcolor="#f5c518" shape=ellipse];
  "loka-jain"           [label="loka (Jain)"           style=filled fillcolor="#f5c518" shape=ellipse];
  "ahimsa"              [label="ahiṃsā"                style=filled fillcolor="#f5c518" shape=ellipse];

  /* Nyaya-Vaisheshika */
  "paramanu-vaisheshika" [label="paramāṇu (Vaiśeṣika)" style=filled fillcolor="#82b4ff" shape=ellipse];
  "dravya-vaisheshika"   [label="dravya (Vaiśeṣika)"   style=filled fillcolor="#82b4ff" shape=ellipse];

  /* Samkhya */
  "prakriti-samkhya"    [label="prakṛti"               style=filled fillcolor="#d8b4fe" shape=ellipse];
  "purusha-samkhya"     [label="puruṣa"                style=filled fillcolor="#d8b4fe" shape=ellipse];
  "guna-samkhya"        [label="guṇa (Sāṃkhya)"        style=filled fillcolor="#d8b4fe" shape=ellipse];

  /* Vedanta */
  "atman-vedanta"       [label="ātman (Vedānta)"        style=filled fillcolor="#b0e0b0" shape=ellipse];
  "brahman"             [label="brahman"               style=filled fillcolor="#b0e0b0" shape=ellipse];
  "maya-advaita"        [label="māyā (Advaita)"         style=filled fillcolor="#b0e0b0" shape=ellipse];
  "karma-vedic"         [label="karma (Vedic)"          style=filled fillcolor="#b0e0b0" shape=ellipse];

  /* Buddhist */
  "skandha-buddhist"    [label="khandha (Buddhist)"     style=filled fillcolor="#ffa07a" shape=ellipse];
  "anatta-buddhist"     [label="anattā"                style=filled fillcolor="#ffa07a" shape=ellipse];
  "nirvana-buddhist"    [label="nirvāṇa"               style=filled fillcolor="#ffa07a" shape=ellipse];
  "pratityasamutpada"   [label="pratītyasamutpāda"     style=filled fillcolor="#ffa07a" shape=ellipse];
  "sunyata"             [label="śūnyatā"               style=filled fillcolor="#ffa07a" shape=ellipse];

  /* Greek */
  "democritus-atom"     [label="atomos (Greek)"         style=filled fillcolor="#c0c0c0" shape=ellipse];

  /* Modern Physics */
  "modern-atom"         [label="modern atom"            style=filled fillcolor="#e0e0e0" shape=ellipse];
  "many-valued-logic"   [label="many-valued logic"      style=filled fillcolor="#e0e0e0" shape=ellipse];

  /* === UNWRITTEN STUBS (box) === */
  "quantum-complementarity" [label="quantum complementarity" style=filled fillcolor="#dddddd" shape=box];
  "moksha-advaita"      [label="mokṣa (Advaita)"        style=filled fillcolor="#dddddd" shape=box];
  "omniscience-vedanta" [label="omniscience (Vedānta)"   style=filled fillcolor="#dddddd" shape=box];
  "pramana-nyaya"       [label="pramāṇa (Nyāya)"        style=filled fillcolor="#dddddd" shape=box];
  "ahimsa-buddhist"     [label="ahiṃsā (Buddhist)"      style=filled fillcolor="#dddddd" shape=box];

  /* ================================================================
     EDGES
     solid   = structural (is-a-type-of, part-of, expressed-by, formalizes, aggregates-*)
     dashed  = honest cross-tradition (structurally-parallel-to, shares-vocabulary-with, historically-influenced-by)
     dotted  = often-conflated-with-NOT-equivalent
     ================================================================ */

  /* tattva-jain.md */
  "tattva-jain" -> "jiva"            [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "ajiva"           [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "asrava"          [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "bandha"          [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "samvara"         [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "nirjara"         [label="formalizes"       style=solid  color="#555555"];
  "tattva-jain" -> "moksha"          [label="formalizes"       style=solid  color="#555555"];

  /* pramana.md */
  "pramana" -> "naya"                [label="expressed-by"     style=solid  color="#555555"];
  "pramana" -> "kevala-jnana"        [label="structurally-parallel-to" style=dashed color="#009933"];
  "pramana" -> "pramana-nyaya"       [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* naya.md */
  "naya" -> "anekantavada"           [label="part-of"          style=solid  color="#333333"];
  "naya" -> "syadvada"               [label="expressed-by"     style=solid  color="#555555"];
  "naya" -> "pramana"                [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* jiva.md */
  "jiva" -> "dravya"                 [label="is-a-type-of"     style=solid  color="#333333"];
  "jiva" -> "atman-vedanta"          [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "jiva" -> "atman-vedanta"          [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* ajiva.md */
  "ajiva" -> "dravya"                [label="part-of"          style=solid  color="#333333"];
  "ajiva" -> "pudgala"               [label="is-a-type-of"     style=solid  color="#333333"];
  "ajiva" -> "jiva"                  [label="part-of"          style=solid  color="#333333"];

  /* dravya.md */
  "dravya" -> "jiva"                 [label="is-a-type-of"     style=solid  color="#333333"];
  "dravya" -> "ajiva"                [label="is-a-type-of"     style=solid  color="#333333"];
  "dravya" -> "pudgala"              [label="is-a-type-of"     style=solid  color="#333333"];
  "dravya" -> "dravya-vaisheshika"   [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* paramanu.md */
  "paramanu" -> "pudgala"            [label="part-of"          style=solid  color="#333333"];
  "paramanu" -> "skandha"            [label="aggregates-into"  style=solid  color="#555555"];
  "paramanu" -> "paramanu-vaisheshika" [label="structurally-parallel-to" style=dashed color="#009933"];
  "paramanu" -> "modern-atom"        [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* pudgala.md */
  "pudgala" -> "ajiva"               [label="is-a-type-of"     style=solid  color="#333333"];
  "pudgala" -> "dravya"              [label="is-a-type-of"     style=solid  color="#333333"];
  "pudgala" -> "paramanu"            [label="expressed-by"     style=solid  color="#555555"];
  "pudgala" -> "skandha"             [label="expressed-by"     style=solid  color="#555555"];
  "pudgala" -> "prakriti-samkhya"    [label="structurally-parallel-to" style=dashed color="#009933"];
  "pudgala" -> "prakriti-samkhya"    [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* skandha.md */
  "skandha" -> "paramanu"            [label="aggregates-from"  style=solid  color="#555555"];
  "skandha" -> "pudgala"             [label="part-of"          style=solid  color="#333333"];
  "skandha" -> "skandha-buddhist"    [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* asrava.md */
  "asrava" -> "karma"                [label="part-of"          style=solid  color="#333333"];
  "asrava" -> "bandha"               [label="expressed-by"     style=solid  color="#555555"];
  "asrava" -> "jiva"                 [label="part-of"          style=solid  color="#333333"];

  /* karma.md */
  "karma" -> "skandha"               [label="is-a-type-of"     style=solid  color="#333333"];
  "karma" -> "pudgala"               [label="part-of"          style=solid  color="#333333"];
  "karma" -> "jiva"                  [label="part-of"          style=solid  color="#333333"];
  "karma" -> "karma-vedic"           [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* bandha.md */
  "bandha" -> "karma"                [label="part-of"          style=solid  color="#333333"];
  "bandha" -> "asrava"               [label="expressed-by"     style=solid  color="#555555"];
  "bandha" -> "samvara"              [label="expressed-by"     style=solid  color="#555555"];
  "bandha" -> "tattva-jain"          [label="part-of"          style=solid  color="#333333"];

  /* nirjara.md */
  "nirjara" -> "karma"               [label="part-of"          style=solid  color="#333333"];
  "nirjara" -> "samvara"             [label="expressed-by"     style=solid  color="#555555"];
  "nirjara" -> "moksha"              [label="part-of"          style=solid  color="#333333"];

  /* samvara.md */
  "samvara" -> "karma"               [label="part-of"          style=solid  color="#333333"];
  "samvara" -> "asrava"              [label="expressed-by"     style=solid  color="#555555"];
  "samvara" -> "nirjara"             [label="expressed-by"     style=solid  color="#555555"];
  "samvara" -> "moksha"              [label="part-of"          style=solid  color="#333333"];

  /* moksha.md */
  "moksha" -> "jiva"                 [label="part-of"          style=solid  color="#333333"];
  "moksha" -> "karma"                [label="part-of"          style=solid  color="#333333"];
  "moksha" -> "moksha-advaita"       [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* anekantavada.md */
  "anekantavada" -> "syadvada"       [label="expressed-by"     style=solid  color="#555555"];
  "anekantavada" -> "saptabhangi"    [label="formalizes"       style=solid  color="#555555"];
  "anekantavada" -> "dravya"         [label="part-of"          style=solid  color="#333333"];
  "anekantavada" -> "quantum-complementarity" [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* syadvada.md */
  "syadvada" -> "anekantavada"       [label="part-of"          style=solid  color="#333333"];
  "syadvada" -> "saptabhangi"        [label="expressed-by"     style=solid  color="#555555"];
  "syadvada" -> "naya"               [label="formalizes"       style=solid  color="#555555"];

  /* saptabhangi.md */
  "saptabhangi" -> "syadvada"        [label="formalizes"       style=solid  color="#555555"];
  "saptabhangi" -> "anekantavada"    [label="part-of"          style=solid  color="#333333"];
  "saptabhangi" -> "many-valued-logic" [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* kevala-jnana.md */
  "kevala-jnana" -> "moksha"         [label="part-of"          style=solid  color="#333333"];
  "kevala-jnana" -> "karma"          [label="part-of"          style=solid  color="#333333"];
  "kevala-jnana" -> "pramana"        [label="structurally-parallel-to" style=dashed color="#009933"];
  "kevala-jnana" -> "omniscience-vedanta" [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* loka-jain.md */
  "loka-jain" -> "dravya"            [label="part-of"          style=solid  color="#333333"];
  "loka-jain" -> "moksha"            [label="part-of"          style=solid  color="#333333"];
  "loka-jain" -> "ajiva"             [label="part-of"          style=solid  color="#333333"];

  /* ahimsa.md */
  "ahimsa" -> "jiva"                 [label="part-of"          style=solid  color="#333333"];
  "ahimsa" -> "karma"                [label="part-of"          style=solid  color="#333333"];
  "ahimsa" -> "ahimsa-buddhist"      [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* paramanu-vaisheshika.md */
  "paramanu-vaisheshika" -> "paramanu"   [label="structurally-parallel-to" style=dashed color="#009933"];
  "paramanu-vaisheshika" -> "dravya-vaisheshika" [label="is-a-type-of" style=solid color="#333333"];

  /* dravya-vaisheshika.md */
  "dravya-vaisheshika" -> "dravya"       [label="shares-vocabulary-with" style=dashed color="#0066cc"];
  "dravya-vaisheshika" -> "paramanu-vaisheshika" [label="is-a-type-of" style=solid color="#333333"];
  "dravya-vaisheshika" -> "atman-vedanta" [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* prakriti-samkhya.md */
  "prakriti-samkhya" -> "pudgala"        [label="structurally-parallel-to" style=dashed color="#009933"];
  "prakriti-samkhya" -> "guna-samkhya"   [label="is-a-type-of" style=solid color="#333333"];

  /* purusha-samkhya.md */
  "purusha-samkhya" -> "jiva"            [label="structurally-parallel-to" style=dashed color="#009933"];
  "purusha-samkhya" -> "atman-vedanta"   [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "purusha-samkhya" -> "prakriti-samkhya" [label="expressed-by" style=solid color="#555555"];

  /* guna-samkhya.md */
  "guna-samkhya" -> "prakriti-samkhya"   [label="part-of"       style=solid color="#333333"];
  "guna-samkhya" -> "dravya"             [label="shares-vocabulary-with" style=dashed color="#0066cc"];
  "guna-samkhya" -> "pudgala"            [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* atman-vedanta.md */
  "atman-vedanta" -> "jiva"              [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "atman-vedanta" -> "jiva"              [label="shares-vocabulary-with" style=dashed color="#0066cc"];
  "atman-vedanta" -> "brahman"           [label="is-a-type-of"  style=solid color="#333333"];
  "atman-vedanta" -> "moksha-advaita"    [label="part-of"       style=solid color="#333333"];

  /* brahman.md */
  "brahman" -> "atman-vedanta"           [label="is-a-type-of"  style=solid color="#333333"];
  "brahman" -> "sunyata"                 [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "brahman" -> "dravya"                  [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* maya-advaita.md */
  "maya-advaita" -> "atman-vedanta"      [label="part-of"       style=solid color="#333333"];
  "maya-advaita" -> "brahman"            [label="part-of"       style=solid color="#333333"];
  "maya-advaita" -> "sunyata"            [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "maya-advaita" -> "dravya"             [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* karma-vedic.md */
  "karma-vedic" -> "karma"               [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "karma-vedic" -> "karma"               [label="shares-vocabulary-with" style=dashed color="#0066cc"];
  "karma-vedic" -> "atman-vedanta"       [label="part-of"       style=solid color="#333333"];

  /* skandha-buddhist.md */
  "skandha-buddhist" -> "skandha"        [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "skandha-buddhist" -> "jiva"           [label="shares-vocabulary-with" style=dashed color="#0066cc"];

  /* anatta-buddhist.md */
  "anatta-buddhist" -> "jiva"            [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "anatta-buddhist" -> "nirvana-buddhist" [label="part-of"      style=solid color="#333333"];
  "anatta-buddhist" -> "skandha-buddhist" [label="part-of"      style=solid color="#333333"];
  "anatta-buddhist" -> "atman-vedanta"   [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

  /* nirvana-buddhist.md */
  "nirvana-buddhist" -> "moksha"         [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "nirvana-buddhist" -> "moksha"         [label="shares-vocabulary-with" style=dashed color="#0066cc"];
  "nirvana-buddhist" -> "anatta-buddhist" [label="part-of"      style=solid color="#333333"];
  "nirvana-buddhist" -> "pratityasamutpada" [label="part-of"    style=solid color="#333333"];

  /* pratityasamutpada.md */
  "pratityasamutpada" -> "karma"         [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];
  "pratityasamutpada" -> "nirvana-buddhist" [label="part-of"    style=solid color="#333333"];
  "pratityasamutpada" -> "karma"         [label="shares-vocabulary-with" style=dashed color="#0066cc"];

