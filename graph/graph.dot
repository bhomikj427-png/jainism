  "democritus-atom" -> "paramanu-vaisheshika" [label="structurally-parallel-to" style=dashed color="#009933"];
  "democritus-atom" -> "modern-atom"     [label="often-conflated-with-NOT-equivalent" style=dotted color="#cc0000"];

